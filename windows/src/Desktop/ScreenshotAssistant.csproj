<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyName>ChatGPT assistant</AssemblyName>
    <Product>ChatGPT assistant</Product>
    <Title>ChatGPT assistant</Title>
    <ApplicationIcon Condition="'$(ApplicationIcon)' == ''">Assets/app.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <Content Include="Renderer/**/*" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.3800.47" />
    <Resource Include="Assets/app.ico" />
    <PackageReference Include="CSharpMath.SkiaSharp" Version="0.5.1" />
    <PackageReference Include="Markdig" Version="1.3.2" />
    <PackageReference Include="SkiaSharp" Version="2.88.9" />
  </ItemGroup>
</Project>
